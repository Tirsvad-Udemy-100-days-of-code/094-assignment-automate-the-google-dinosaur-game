# Doxyfile for the Dino Bot.
# Run "doxygen" from the repository root; HTML goes to docs/doxygen/html.
PROJECT_NAME           = "Dino Bot"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "A bot that plays the Google Dinosaur Game by reading screen pixels."
OUTPUT_DIRECTORY       = docs/doxygen
OUTPUT_LANGUAGE        = English
INPUT                  = src README.md
FILE_PATTERNS          = *.py
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*
USE_MDFILE_AS_MAINPAGE = README.md
OPTIMIZE_OUTPUT_JAVA   = YES
PYTHON_DOCSTRING       = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
QUIET                  = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
SOURCE_BROWSER         = YES
HAVE_DOT               = NO
